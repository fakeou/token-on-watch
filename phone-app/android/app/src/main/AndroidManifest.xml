<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.tokenmonitor">

    <!-- 蓝牙权限（用于与手表通信） -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- 网络权限（用于 API 请求） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 查询穿戴互联相关包（用于动态加载 IPC SDK） -->
    <queries>
        <package android:name="com.mi.health" />
        <package android:name="com.xiaomi.wearable" />
        <intent>
            <action android:name="com.xiaomi.wearable.XMS_WEARABLE_SERVICE" />
        </intent>
        <package android:name="com.xiaomi.mi_connect" />
        <package android:name="com.xiaomi.mi_connect_service" />
        <package android:name="com.xiaomi.health" />
        <package android:name="com.mi.health.global" />
    </queries>

    <application
        android:label="Token Monitor"
        android:name=".TokenMonitorApp"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Flutter 默认启动配置 -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Flutter 生成的元数据 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
